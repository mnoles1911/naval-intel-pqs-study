# Copy to .env and fill in.

# --- Database (PostgreSQL) ---
# Local dev: run a local Postgres and use e.g.
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wedding?schema=public"
# Cloud (Vercel + Neon/Vercel Postgres): the integration sets DATABASE_URL for you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# --- Auth ---
# The single shared password used to log in.
APP_PASSWORD="change-me"
# Long random string used to sign the session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Photo storage (cloud only) ---
# Automatically provided by Vercel when you add Blob storage. Leave unset for
# local dev (photos are then written to public/uploads instead).
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
