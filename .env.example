# Copy to .env and fill in.

# --- Database ---
# Local dev (SQLite): DATABASE_URL="file:./dev.db"
# Production (Postgres): DATABASE_URL="postgresql://USER:PASS@HOST:5432/DB?sslmode=require"
DATABASE_URL="file:./dev.db"

# --- Auth ---
# The single shared password used to log in.
APP_PASSWORD="change-me"
# Long random string used to sign the session cookie.
SESSION_SECRET="change-me-to-a-long-random-string"
