// Wedding Decor & Stationery Placement Planner — data model
//
// Two object types with a many-to-one relationship:
//   - A Location has many Items.
//   - An Item belongs to at most one Location (nullable => "Unassigned").
//   - Deleting a Location sets its items back to Unassigned (onDelete: SetNull).
//
// Deployment uses PostgreSQL (DATABASE_URL). A single shared password gates
// the whole app, so there is no user table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Optional accent color (hex) used by the dashboard, plan board, and legend.
  color       String?
  // Position on the visual floor-plan board (0..1 fractions of the canvas).
  // Null until the couple places the zone on the plan.
  planX       Float?
  planY       Float?
  // Size of the marker on the map (0..1 fractions of the canvas). Null uses a
  // sensible default; the user can resize a marker to override.
  planW       Float?
  planH       Float?
  // Manual ordering for the plan board / setup sheets (lower shows first).
  sortOrder   Int      @default(0)
  // Seating: a Location doubles as a table. Its shape is one of TABLE_SHAPES
  // (ROUND / RECT) and seatCount is how many guests it seats.
  shape       String   @default("ROUND")
  seatCount   Int      @default(8)
  items       Item[]
  assignments SeatAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A group of guests who must be seated together (a couple, a family, a
// friend group). Linking two people puts them in the same Party; the seating
// chart flags a Party whose members are split across different tables.
model Party {
  id        String   @id @default(cuid())
  name      String
  // Optional accent color (hex) for the party's pucks on the seating chart.
  color     String?
  people    Person[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A guest. Their seat is not stored here — it lives in a SeatAssignment scoped
// to a SeatingPlan, so several plans can seat the same guest differently.
model Person {
  id          String   @id @default(cuid())
  name        String
  notes       String?
  party       Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyId     String?
  assignments SeatAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A saved seating arrangement (a "version"). Duplicating a plan copies all of
// its assignments, so past ideas can be revisited. Exactly one plan is active.
model SeatingPlan {
  id          String   @id @default(cuid())
  name        String
  notes       String?
  isActive    Boolean  @default(false)
  assignments SeatAssignment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One guest seated in one seat (seatIndex, 0-based) at one table (location),
// within one plan. A guest holds at most one seat per plan, and a seat holds
// at most one guest per plan.
model SeatAssignment {
  id         String      @id @default(cuid())
  plan       SeatingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  planId     String
  person     Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String
  location   Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  seatIndex  Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([planId, personId])
  @@unique([planId, locationId, seatIndex])
}

model Item {
  id          String     @id @default(cuid())
  name        String
  description String?
  // Acquisition status. One of ITEM_STATUSES (NEEDED / PURCHASED).
  // See src/lib/constants.ts.
  status      String    @default("NEEDED")
  // How many of this physical object are needed (e.g. 24 votives).
  quantity    Int       @default(1)
  // Optional grouping. One of ITEM_CATEGORIES (see src/lib/constants.ts).
  category    String?
  // Planning priority. One of ITEM_PRIORITIES (LOW/MEDIUM/HIGH).
  priority    String    @default("MEDIUM")
  // Where it's coming from.
  vendorName  String?
  vendorUrl   String?
  // Free-form planning notes (setup instructions, reminders, etc.).
  notes       String?
  // Cover photo (kept in sync with the first of photoUrls) plus the full
  // gallery of photos for this item.
  photoUrl    String?
  photoUrls   String[]  @default([])
  // Optional free position on the venue map (0..1 fractions of the canvas).
  // Null until the item is placed on the map.
  planX       Float?
  planY       Float?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
