// Wedding Decor & Stationery Placement Planner — data model
//
// Two object types with a many-to-one relationship:
//   - A Location has many Items.
//   - An Item belongs to at most one Location (nullable => "Unassigned").
//   - Deleting a Location sets its items back to Unassigned (onDelete: SetNull).
//
// Local dev uses SQLite (zero setup). For an online deployment, switch the
// datasource provider to "postgresql" and point DATABASE_URL at a hosted DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Item {
  id          String     @id @default(cuid())
  name        String
  description String?
  // Status is one of the values in ITEM_STATUSES (see src/lib/constants.ts).
  // Stored as a string because SQLite does not support Prisma enums.
  status      String    @default("NEEDED")
  photoUrl    String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
