// Wedding Decor & Stationery Placement Planner — data model
//
// Two object types with a many-to-one relationship:
//   - A Location has many Items.
//   - An Item belongs to at most one Location (nullable => "Unassigned").
//   - Deleting a Location sets its items back to Unassigned (onDelete: SetNull).
//
// Deployment uses PostgreSQL (DATABASE_URL). A single shared password gates
// the whole app, so there is no user table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Optional accent color (hex) used by the dashboard, plan board, and legend.
  color       String?
  // Position on the visual floor-plan board (0..1 fractions of the canvas).
  // Null until the couple places the zone on the plan.
  planX       Float?
  planY       Float?
  // Manual ordering for the plan board / setup sheets (lower shows first).
  sortOrder   Int      @default(0)
  items       Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Item {
  id          String     @id @default(cuid())
  name        String
  description String?
  // Acquisition + readiness lifecycle. One of ITEM_STATUSES
  // (NEEDED -> PURCHASED -> READY). See src/lib/constants.ts.
  status      String    @default("NEEDED")
  // How many of this physical object are needed (e.g. 24 votives).
  quantity    Int       @default(1)
  // Optional grouping. One of ITEM_CATEGORIES (see src/lib/constants.ts).
  category    String?
  // Planning priority. One of ITEM_PRIORITIES (LOW/MEDIUM/HIGH).
  priority    String    @default("MEDIUM")
  // Budget tracking (in whole currency units; couple's local currency).
  estimatedCost Float?
  actualCost    Float?
  // Where it's coming from.
  vendorName  String?
  vendorUrl   String?
  // Free-form planning notes (setup instructions, reminders, etc.).
  notes       String?
  photoUrl    String?
  location    Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
